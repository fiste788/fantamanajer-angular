{
  "name": "fantamanajer-angular",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --proxy-config=proxy.dev.conf.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "npm run lint:scss && npm run prettier && npm run lint:ts",
    "lint:fix": "npm run prettier:fix && npm run lint:ts:fix && npm run lint:scss:fix",
    "lint:ts": "ng lint",
    "lint:ts:fix": "ng lint --fix",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:scss:fix": "stylelint \"src/**/*.scss\" --fix",
    "prettier": "prettier --check \"src/**/*.{scss,html}\" --log-level warn",
    "prettier:fix": "prettier --write \"src/**/*.{scss,html}\" --log-level warn",
    "build": "ng build",
    "build:stats": "ng build --stats-json",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "extract-mat-icon": "node ./tools/extract-mat-icon.mjs \"src\""
  },
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.2.15"
    },
    "runtime": {
      "name": "node",
      "version": "26.0.0"
    }
  },
  "dependencies": {
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/material": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-server": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/service-worker": "^22.0.1",
    "@angular/ssr": "^22.0.1",
    "@auth0/angular-jwt": "^5.2.0",
    "@ecodev/fab-speed-dial": "^21.0.4",
    "@fontsource-variable/exo-2": "^5.2.8",
    "@github/webauthn-json": "^2.1.1",
    "@ngneat/content-loader": "^7.0.0",
    "@types/html-minifier-next": "^4.1.0",
    "itty-router": "^5.0.24",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "^22.0.0",
    "@angular-eslint/builder": "22.0.0",
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "angular-eslint": "^22.0.0",
    "browserslist": "^4.28.2",
    "eslint": "^10.4.1",
    "eslint-config-angular-strict": "^22.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-rxjs-x": "^1.0.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "html-minifier-next": "^6.2.11",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "stylelint": "^17.13.0",
    "stylelint-browser-compat": "^1.0.0-beta.180",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-plugin-use-baseline": "^1.4.2",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.2.0",
    "tailwindcss": "^3.4.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "wrangler": "^4.99.0"
  }
}
